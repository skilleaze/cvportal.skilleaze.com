{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/Portal.dc",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/Portal.dc.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/Skilleaze%20CV%20Builder.dc",
      "destination": "/ats-cv-builder",
      "permanent": false
    },
    {
      "source": "/Skilleaze%20CV%20Builder.dc.html",
      "destination": "/ats-cv-builder",
      "permanent": false
    },
    {
      "source": "/Skilleaze%20Europass%20CV%20Builder.dc",
      "destination": "/europass-cv-builder",
      "permanent": false
    },
    {
      "source": "/Skilleaze%20Europass%20CV%20Builder.dc.html",
      "destination": "/europass-cv-builder",
      "permanent": false
    }
  ]
}